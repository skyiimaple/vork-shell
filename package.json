{
  "name": "vork-shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A universal workspace for terminals and databases",
  "engines": {
    "node": ">=22"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm release:notes:check && pnpm check:ui && pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "test:enhancements": "pnpm build && electron scripts/enhancements-smoke.cjs",
    "test:desktop": "pnpm build && electron scripts/smoke.cjs",
    "check:ui": "node scripts/check-ui.cjs",
    "test:workflows": "pnpm build && electron scripts/workflows-smoke.cjs",
    "test:connections": "pnpm build && electron scripts/connection-regression-smoke.cjs",
    "test:snippets": "pnpm build && electron scripts/snippets-smoke.cjs",
    "test:table-data": "pnpm build && electron scripts/table-data-smoke.cjs",
    "release:notes": "node scripts/release-notes.cjs",
    "release:notes:check": "node scripts/release-notes.cjs --check",
    "release:preflight": "node scripts/release-preflight.cjs",
    "package:mac": "pnpm build && VORK_UNSIGNED=1 VORK_USE_LOCAL_ELECTRON=1 electron-builder --config electron-builder.cjs --mac --publish never",
    "package:dir": "pnpm build && VORK_UNSIGNED=1 VORK_USE_LOCAL_ELECTRON=1 electron-builder --config electron-builder.cjs --dir --publish never",
    "package:release": "pnpm release:preflight && pnpm check && electron-builder --config electron-builder.cjs --publish never",
    "test:projects": "pnpm build && electron scripts/projects-smoke.cjs",
    "test:import": "pnpm build && electron scripts/import-smoke.cjs",
    "test:release": "pnpm build && electron scripts/release-smoke.cjs",
    "prepare": "husky",
    "test:docker": "pnpm build && electron scripts/docker-services-smoke.cjs",
    "test:mongodb": "pnpm build && electron scripts/mongodb-smoke.cjs",
    "test:result-export": "pnpm build && electron scripts/result-export-smoke.cjs",
    "test:query-recovery": "pnpm build && electron scripts/query-recovery-smoke.cjs",
    "test:schema-tools": "pnpm build && electron scripts/schema-tools-smoke.cjs",
    "test:schema-column-edit": "pnpm build && electron scripts/schema-column-edit-smoke.cjs",
    "test:ai-sql": "pnpm build && electron scripts/ai-sql-smoke.cjs",
    "test:query-plan": "pnpm build && electron scripts/query-plan-smoke.cjs",
    "test:er-diagram": "pnpm build && electron scripts/er-diagram-smoke.cjs",
    "test:structure-compare": "pnpm build && electron scripts/structure-compare-smoke.cjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@lucide/vue": "^1.52.0",
    "@tanstack/vue-query": "5.104.1",
    "@tanstack/vue-table": "9.2.6",
    "@tanstack/vue-virtual": "3.13.39",
    "@vueuse/core": "^15.0.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron-updater": "6.8.9",
    "exceljs": "4.4.0",
    "mongodb": "^7.7.0",
    "mysql2": "3.24.5",
    "pg": "8.23.1",
    "redis": "6.3.0",
    "reka-ui": "2.11.0",
    "ssh2": "1.17.0",
    "tailwind-merge": "3.7.0",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/ssh2": "1.15.6",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unicorn": "^77.0.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "7.3.6",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.12"
  },
  "packageManager": "pnpm@11.5.1",
  "author": "Vork Shell contributors",
  "lint-staged": {
    "*.{ts,tsx,vue,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,scss,html,yaml,yml}": [
      "prettier --write"
    ]
  }
}
